// Esquema de Base de Datos para Kroma Lab Sales Studio (PostgreSQL - Neon Serverless)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum OrderStatus {
  PENDING_REVIEW
  IN_AUDLEY_QUEUE
  PRINTING
  LAMINATING_CUTTING
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String
  phone             String?
  company           String?
  taxId             String?   // NIT SAT
  address           String?
  department        String?   // Taller, Ventas, etc.
  role              Role      @default(CUSTOMER)
  isVerified        Boolean   @default(true)
  refreshToken      String?
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paymentsRecorded  Payment[]
  kardexMovements   InventoryMovement[]
}

model Customer {
  id          String   @id @default(cuid())
  companyName String?
  managerName String
  phone       String
  email       String   @unique
  address     String?
  taxId       String?  // NIT en Guatemala (ej. 7845129-4 o CF)
  tier        String   @default("NUEVO") // VIP, RECURRENTE, NUEVO, INACTIVO
  sector      String   @default("COMERCIO_RETAIL")
  notes       String?

  orders      Order[]
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id             String         @id @default(cuid())
  code           String         @unique // Ej. "KL-2026-001"
  status         OrderStatus    @default(PENDING_REVIEW)
  paymentStatus  PaymentStatus  @default(PENDING)

  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Datos desnormalizados del cliente
  customerName   String
  customerPhone  String
  customerEmail  String?
  customerTaxId  String?
  customerAddress String?

  // Metadatos de impresión UV DTF (Bobina Audley 28 cm útiles)
  widthCm        Decimal        @db.Decimal(6, 2)
  heightCm       Decimal        @db.Decimal(6, 2)
  qty            Int
  linearMeters   Decimal        @db.Decimal(6, 2)
  withCutting    Boolean        @default(false)
  finishType     String         @default("GLOSSY_VARNISH")

  stickersPerRow Int            @default(1)
  rows           Int            @default(1)

  // Desglose financiero (Quetzales GTQ)
  unitRateQ      Decimal        @default(105.0) @db.Decimal(10, 2)
  materialPriceQ Decimal        @db.Decimal(10, 2)
  cuttingPriceQ  Decimal        @default(0.0) @db.Decimal(10, 2)
  totalAmountQ   Decimal        @db.Decimal(10, 2)
  amountPaidQ    Decimal        @default(0.0) @db.Decimal(10, 2)

  // Archivo de diseño en Cloudflare R2
  fileUrl        String?
  fileName       String?
  fileSizeBytes  Int?
  notes          String?

  dispatchNotes  DispatchNote[]
  payments       Payment[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Quote {
  id                 String   @id @default(cuid())
  code               String?  @unique
  projectName        String?
  leadName           String?
  leadPhone          String?
  leadEmail          String?
  companyName        String?
  widthCm            Decimal  @db.Decimal(6, 2)
  heightCm           Decimal  @db.Decimal(6, 2)
  qty                Int
  linearMeters       Decimal  @db.Decimal(6, 2)
  stickersPerRow     Int      @default(1)
  rows               Int      @default(1)
  unitRateQ          Decimal  @db.Decimal(10, 2)
  materialPriceQ     Decimal  @db.Decimal(10, 2)
  cuttingPriceQ      Decimal  @default(0.0) @db.Decimal(10, 2)
  totalPriceQ        Decimal  @db.Decimal(10, 2)
  withCutting        Boolean  @default(false)
  finishType         String   @default("GLOSSY_VARNISH")
  status             String   @default("SAVED")
  convertedOrderId   String?
  convertedOrderCode String?
  // Archivo de diseño adjunto (Cloudflare R2)
  fileUrl            String?
  fileName           String?
  fileSizeBytes      Int?
  notes              String?
  source             String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DispatchNote {
  id                    String    @id @default(cuid())
  folio                 String    @unique // Ej. "REM-2026-001"
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerName          String
  customerPhone         String
  customerAddress       String
  customerTaxId         String?

  deliveryMethod        String    @default("MOTO_LOCAL")
  trackingNumber        String?
  packagesCount         Int       @default(1)
  linearMeters          Decimal   @db.Decimal(6, 2)
  totalAmountQ          Decimal   @db.Decimal(10, 2)
  balanceDueQ           Decimal   @default(0.0) @db.Decimal(10, 2)

  status                String    @default("PREPARED")

  deliveryRecipientName String?
  deliveryRecipientDpi  String?
  checklistPassed       Boolean   @default(true)
  notes                 String?

  deliveredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model InventoryItem {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  category          String
  unit              String
  currentStock      Decimal             @db.Decimal(10, 2)
  minStockThreshold Decimal             @db.Decimal(10, 2)
  unitCostQ         Decimal             @db.Decimal(10, 2)
  optimalRatio      Decimal             @default(1.5) @db.Decimal(6, 2)

  movements         InventoryMovement[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model InventoryMovement {
  id          String        @id @default(cuid())
  movCode     String        @unique
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String
  qtyDelta    Decimal       @db.Decimal(10, 2)
  newStock    Decimal       @db.Decimal(10, 2)
  totalCostQ  Decimal       @default(0.0) @db.Decimal(10, 2)
  reference   String?
  notes       String?

  performedById String?
  performedBy   User?       @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  paymentCode   String   @unique
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerName  String
  customerTaxId String?
  amountPaidQ   Decimal  @db.Decimal(10, 2)
  method        String
  bankName      String?
  bankReference String?
  receiptUrl    String?
  notes         String?

  registeredById String?
  registeredBy   User?   @relation(fields: [registeredById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
}

model WorkshopConfig {
  id                    String   @id @default("default")
  printableRollWidthCm  Decimal  @default(28.0) @db.Decimal(6, 2)
  rollWidthCm           Decimal  @default(30.0) @db.Decimal(6, 2)
  rateTier1             Decimal  @default(130.0) @db.Decimal(10, 2)
  rateTier2             Decimal  @default(120.0) @db.Decimal(10, 2)
  rateTier3             Decimal  @default(115.0) @db.Decimal(10, 2)
  rateTier4             Decimal  @default(105.0) @db.Decimal(10, 2)
  rateTier5             Decimal  @default(95.0) @db.Decimal(10, 2)
  cuttingFeePerPieceQ   Decimal  @default(0.08) @db.Decimal(10, 2)

  bankBiAccount         String   @default("144-002931-2")
  bankBacAccount        String   @default("90-341902-1")
  bankBanruralAccount   String   @default("3033-09182-1")
  whatsappNumber        String   @default("+502 5555-0000")

  filmACostPerM         Decimal  @default(6.30) @db.Decimal(10, 2)
  filmBCostPerM         Decimal  @default(4.08) @db.Decimal(10, 2)
  inkCostPerM           Decimal  @default(8.25) @db.Decimal(10, 2)
  monthlyNetTargetQ     Decimal  @default(20000.0) @db.Decimal(10, 2)

  updatedAt             DateTime @updatedAt
}
